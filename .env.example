# Copy to .env. Leave SMTP_* empty in dev and OTPs print to the server console.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
JWT_SECRET=change-me-to-64-random-hex-chars
CLIENT_ORIGIN=http://localhost:5173
# Gmail: enable 2FA, create an App Password. Mailtrap also works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
MAIL_FROM="CineShow <you@gmail.com>"
